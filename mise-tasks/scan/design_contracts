#!/usr/bin/env bash
#MISE description="Design contract anchoring gate (#1064): every C-x / N-x row in scripts/design/contracts.py must anchor to a section that still exists in docs/screen-contracts.md / a row in docs/navigation-flows.md, and both canonical docs must keep their expected shape. Pure python3 stdlib, runs on ubuntu-latest."
#
# Why this exists:
#   contracts.py landed with the v3 design spec as a verification gate, but no
#   CI job and no mise task ever ran it. #1051 renamed `## STATS` to
#   `## PROGRESS` in docs/screen-contracts.md without re-pointing the four
#   change rows that anchored to it, and the gate sat at RESULT: FAIL on main,
#   merge after merge, until someone ran it by hand (#1064).
#   This wrapper makes it discoverable (`mise tasks ls`) and lets lint.yml
#   fail the PR that breaks an anchor, instead of a later reader finding it.
#
# Runs the script's default gate mode: exit 1 on canonical drift or a broken
# anchor. Extra args pass through (e.g. `-- --verbose` to list every anchor).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT"

exec python3 scripts/design/contracts.py "$@"
