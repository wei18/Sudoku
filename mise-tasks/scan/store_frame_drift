#!/usr/bin/env bash
#MISE description="ASC frame drift gate (#1001/#1112): fail a PR that changes a snapshot baseline feeding a Slot() — or a live-simulator capture feeding a CaptureSlot() (#1054) — in scripts/build-ascspec-screenshots.py without regenerating EVERY docs/app-store/screenshots-ascspec/ frame that baseline feeds (a Slot() feeds every locale; a CaptureSlot() feeds only its own locale). Pure git/grep — no Python, no Pillow, no fonts, runs on ubuntu-latest. The real regenerate-and-diff check needs macOS system fonts (see script header) and can't run there."
#USAGE flag "--base <ref>" help="Base ref to diff against (default: origin/main, falling back to main)"
#USAGE flag "--list" help="Print the derived baseline -> slot -> locale mapping and exit 0 (no gate check)" default="false"
#
# What this catches (and does not):
#   Catches the #995/#998/#1112 failure mode: a committed snapshot baseline
#   (or live capture, #1054) that FEEDS a Slot()/CaptureSlot() changes, but
#   not every frame it feeds under docs/app-store/screenshots-ascspec/ gets
#   regenerated in the same PR — whether that's the wrong slot entirely
#   (#1112), or only some locales (#998). Checked per (device, app, slot,
#   locale), not "did ANY file under screenshots-ascspec/ change". A frame
#   that doesn't exist at HEAD yet (a locale the generator SKIPPED-NO-COPY)
#   is never required.
#
#   Does NOT verify pixel equality between the regenerated frame and the
#   committed one — that needs the actual generator, which needs macOS system
#   fonts (Hiragino Sans GB / PingFang / AppleSDGothicNeo / Ayuthaya, see
#   scripts/build-ascspec-screenshots.py:606-643) and cannot run on this
#   ubuntu-latest fleet. See #1001 for why the simple
#   `python3 scripts/build-ascspec-screenshots.py && git diff --exit-code`
#   gate was rejected.
#
#   Deliberately does NOT fire on every __Snapshots__ change — only on
#   baselines that are actually referenced by a Slot(...) entry in the
#   generator's SLOTS table. Most baselines feed no store frame at all; a
#   gate that fired on all of them would be noise and would get disabled.
#
# Mapping derivation:
#   The SLOTS table and BASELINES_SUDOKU/BASELINES_MS constants are parsed
#   directly out of scripts/build-ascspec-screenshots.py on every run (no
#   hardcoded slot list to rot). See parse_slots() below.
#
# Escape hatch (legitimate "this baseline change doesn't alter the frame"):
#   - PR label `frame-drift-verified`, OR
#   - a trailer on any commit in the PR range:
#       Frame-Drift-Verified: <why the frame doesn't need regenerating>
#   The workflow passes the label as FRAME_DRIFT_LABEL_OVERRIDE=1; the
#   trailer is scanned directly from `git log` here.
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$REPO_ROOT/scripts/build-ascspec-screenshots.py"
ASCSPEC_PREFIX="docs/app-store/screenshots-ascspec/"

BASE_REF=""
LIST_ONLY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base) BASE_REF="${2:-}"; shift 2 ;;
    --list) LIST_ONLY=1; shift ;;
    -h|--help) sed -n '2,4p' "$0" | sed 's/^#MISE[^=]*=//; s/^"//; s/"$//'; exit 0 ;;
    *) echo "error: unknown argument '$1'" >&2; exit 1 ;;
  esac
done

if [[ ! -f "$SCRIPT" ]]; then
  echo "ERROR [store_frame_drift]: generator not found at $SCRIPT" >&2
  exit 1
fi

# ── Derive baseline -> slot mapping from the generator source ────────────────
#
# Extract the two BASELINES_* roots (REPO_ROOT-relative) so we don't hardcode
# the Packages/*/Tests/*UITests/__Snapshots__ paths either.
# `|| true` on each: under `set -o pipefail`, a no-match grep makes the whole
# pipeline (and, under `set -e`, the script) exit right here with no output —
# before the `-z` check below ever gets a chance to print its diagnostic.
BASELINES_SUDOKU_REL="$(grep -E '^BASELINES_SUDOKU = REPO_ROOT / "' "$SCRIPT" | sed -E 's/^BASELINES_SUDOKU = REPO_ROOT \/ "([^"]+)".*/\1/' || true)"
BASELINES_MS_REL="$(grep -E '^BASELINES_MS = REPO_ROOT / "' "$SCRIPT" | sed -E 's/^BASELINES_MS = REPO_ROOT \/ "([^"]+)".*/\1/' || true)"

if [[ -z "$BASELINES_SUDOKU_REL" || -z "$BASELINES_MS_REL" ]]; then
  echo "ERROR [store_frame_drift]: could not parse BASELINES_SUDOKU/BASELINES_MS out of $SCRIPT — script format changed, gate needs updating." >&2
  exit 1
fi

# #1054: LOCALES — read from the single source of truth (never re-typed),
# pure grep/sed (no python, per this gate's own "pure git/grep" design) —
# needed to expand each CaptureSlot(...) (one source file per locale) into
# per-locale watched paths below.
LOCALES_RAW="$(grep -E '^LOCALES = \[' "$SCRIPT" | sed -E 's/^LOCALES = \[(.*)\]/\1/' | tr -d '"' | tr ',' ' ')"
read -r -a ALL_LOCALES <<<"$LOCALES_RAW"
if [[ ${#ALL_LOCALES[@]} -eq 0 ]]; then
  echo "ERROR [store_frame_drift]: could not parse LOCALES out of $SCRIPT — script format changed, gate needs updating." >&2
  exit 1
fi

# Extract the SLOTS = { ... } block (up to the BASELINES_ROOT assignment that
# immediately follows it), flatten to one line so a Slot(...) call that wraps
# across source lines (long entries do, e.g. the "02b-rank" slots) still reads
# as one token, then walk the token stream in order:
#   "<device>": {                    -> enter a device context
#   "sudoku": [ / "minesweeper": [   -> enter an app context
#   Slot(...)                        -> emit one (device, app, slot) row
#   ]                                -> leave the current app context
#   }                                -> leave the current device context
# The bare `]`/`}` tokens exist so a header line that FAILS to match (a
# reformat, a typo, anything) leaves device/app EMPTY rather than STALE at
# the wrong value — see the "Slot(...) found before a device/app context"
# guard below, and the mutation tests in the PR description for why a
# presence-only check (no closing tokens) isn't enough.
TOKENS="$(sed -n '/^SLOTS = {/,/^BASELINES_ROOT = {/p' "$SCRIPT" | tr '\n' ' ' | \
  grep -oE '"[A-Za-z0-9._-]+": \{|"(sudoku|minesweeper)": \[|Slot\([^)]*\)|CaptureSlot\([^)]*\)|\]|\}' || true)"

if [[ -z "$TOKENS" ]]; then
  echo "ERROR [store_frame_drift]: found no SLOTS table content in $SCRIPT — script format changed, gate needs updating." >&2
  exit 1
fi

# rows: device<TAB>app<TAB>slot_name<TAB>baseline_relpath<TAB>locale (one per
# Slot(), locale "*"; one per locale per CaptureSlot(), locale that locale).
ROWS=""
device=""
app=""
while IFS= read -r tok; do
  case "$tok" in
    Slot\(*)
      # Pull the 4 quoted args in declaration order: name, suite_dir, named, prefix.
      # (bash 3.2-compatible: macOS system bash has no `mapfile`.)
      args=()
      while IFS= read -r a; do args+=("$a"); done < <(grep -oE '"[^"]*"' <<<"$tok" | sed -E 's/^"(.*)"$/\1/')
      if [[ ${#args[@]} -ne 4 ]]; then
        echo "ERROR [store_frame_drift]: Slot(...) with ${#args[@]} args (expected 4) while parsing $SCRIPT: $tok" >&2
        exit 1
      fi
      if [[ -z "$device" || -z "$app" ]]; then
        echo "ERROR [store_frame_drift]: Slot(...) found before a device/app context — parser out of sync with $SCRIPT: $tok" >&2
        exit 1
      fi
      slot_name="${args[0]}"; suite_dir="${args[1]}"; named="${args[2]}"; prefix="${args[3]}"
      case "$app" in
        sudoku)       baselines_root="$BASELINES_SUDOKU_REL" ;;
        minesweeper)  baselines_root="$BASELINES_MS_REL" ;;
      esac
      baseline_relpath="${baselines_root}/${suite_dir}/${prefix}.${named}.png"
      # locale "*" — one baseline feeds every locale's frame (#1112).
      ROWS+="${device}"$'\t'"${app}"$'\t'"${slot_name}"$'\t'"${baseline_relpath}"$'\t'"*"$'\n'
      ;;
    CaptureSlot\(*)
      # #1054: CaptureSlot("name", "rel/path/{locale}/template.png") — 2 args,
      # no suite/named/prefix. The watched path is per-locale (a live capture
      # genuinely localizes, unlike a snapshot baseline) — expand into one
      # ROW per locale so a change to ANY locale's capture is caught.
      args=()
      while IFS= read -r a; do args+=("$a"); done < <(grep -oE '"[^"]*"' <<<"$tok" | sed -E 's/^"(.*)"$/\1/')
      if [[ ${#args[@]} -ne 2 ]]; then
        echo "ERROR [store_frame_drift]: CaptureSlot(...) with ${#args[@]} args (expected 2) while parsing $SCRIPT: $tok" >&2
        exit 1
      fi
      if [[ -z "$device" || -z "$app" ]]; then
        echo "ERROR [store_frame_drift]: CaptureSlot(...) found before a device/app context — parser out of sync with $SCRIPT: $tok" >&2
        exit 1
      fi
      slot_name="${args[0]}"; rel_template="${args[1]}"
      for loc in "${ALL_LOCALES[@]}"; do
        baseline_relpath="${rel_template//\{locale\}/$loc}"
        # locale is this row's own locale — a capture only feeds its own
        # locale's frame, unlike a Slot() baseline (locale "*" above).
        ROWS+="${device}"$'\t'"${app}"$'\t'"${slot_name}"$'\t'"${baseline_relpath}"$'\t'"${loc}"$'\n'
      done
      ;;
    \"*\":\ \{)
      device="${tok#\"}"; device="${device%%\":*}"
      ;;
    \"sudoku\":\ \[|\"minesweeper\":\ \[)
      app="${tok#\"}"; app="${app%%\":*}"
      ;;
    ']'|'}')
      # Leaving an app list ("]") always clears app; leaving a device dict
      # ("}") clears both. Unconditional — a stray extra "}" at the very end
      # of SLOTS (closing the top-level dict) just clears already-empty
      # vars, a no-op.
      app=""
      if [[ "$tok" == "}" ]]; then device=""; fi
      ;;
  esac
done <<<"$TOKENS"

if [[ -z "$ROWS" ]]; then
  echo "ERROR [store_frame_drift]: parsed zero Slot() entries out of $SCRIPT — parser out of sync with the script." >&2
  exit 1
fi

if [[ "$LIST_ONLY" -eq 1 ]]; then
  printf '%-11s %-13s %-11s %-180s %s\n' DEVICE APP SLOT BASELINE LOCALE
  echo "$ROWS" | sort | while IFS=$'\t' read -r device app slot_name baseline_relpath locale; do
    [[ -z "$device" ]] && continue
    printf '%-11s %-13s %-11s %-180s %s\n' "$device" "$app" "$slot_name" "$baseline_relpath" "$locale"
  done
  exit 0
fi

# ── Determine the changed-file set for this PR ───────────────────────────────
if [[ -z "$BASE_REF" ]]; then
  if git rev-parse --verify origin/main >/dev/null 2>&1; then
    BASE_REF="origin/main"
  elif git rev-parse --verify main >/dev/null 2>&1; then
    BASE_REF="main"
  else
    echo "ERROR [store_frame_drift]: no --base given and neither origin/main nor main resolves locally." >&2
    exit 1
  fi
fi

if ! MERGE_BASE="$(git merge-base HEAD "$BASE_REF" 2>&1)"; then
  echo "ERROR [store_frame_drift]: git merge-base HEAD $BASE_REF failed: $MERGE_BASE" >&2
  exit 1
fi

CHANGED="$(git diff --name-only "$MERGE_BASE" HEAD)"
# #1112 follow-up: CHANGED includes deleted paths (a frame that was `git rm`'d
# still shows up in --name-only). The per-frame freshness check below must
# tell "regenerated/added" apart from "deleted" rather than treating any
# diff-mentioned path as fresh, so it needs the present-at-HEAD subset too
# (--diff-filter=d excludes deletions).
CHANGED_PRESENT="$(git diff --name-only --diff-filter=d "$MERGE_BASE" HEAD)"

# ── Cross-reference: which changed files are MAPPED baselines/captures? ─────
# (No associative arrays — macOS system bash is 3.2, which predates them.)
CHANGED_MAPPED=""
while IFS=$'\t' read -r device app slot_name baseline_relpath locale; do
  [[ -z "$baseline_relpath" ]] && continue
  if grep -qxF "$baseline_relpath" <<<"$CHANGED"; then
    CHANGED_MAPPED+="${baseline_relpath}"$'\n'
  fi
done <<<"$ROWS"
CHANGED_MAPPED="$(printf '%s' "$CHANGED_MAPPED" | sort -u | sed '/^$/d')"

if [[ -z "$CHANGED_MAPPED" ]]; then
  echo "PASS [store_frame_drift]: no mapped baseline drifted from docs/app-store/screenshots-ascspec/."
  exit 0
fi

# ── Per-slot, per-locale check (#1112) ───────────────────────────────────────
# "Any file under screenshots-ascspec/ changed" is not enough — it's blind to
# the wrong slot being regenerated instead (#1112), to a partial-locale
# regeneration (#998), and to the frame being `git rm`'d outright instead of
# regenerated (also #1112 — a deleted frame still passes "HEAD:${frame}
# doesn't exist, so skip" if that's read as "never generated"). For every
# changed baseline/capture, expand EVERY frame it feeds (a Slot's locale "*"
# means every ALL_LOCALES entry; a CaptureSlot row already names its own
# locale) and classify each expected frame by existence at HEAD vs at
# MERGE_BASE:
#   1. missing at both HEAD and MERGE_BASE  -> skip (the generator
#      SKIPPED-NO-COPY this locale; there was never a frame to regenerate).
#   2. present at HEAD and present (non-deleted) in this diff -> fresh,
#      whether regenerated or newly added.
#   3. anything else (present at HEAD but untouched by the diff, OR present
#      at MERGE_BASE but deleted at HEAD) -> STALE. The deleted-at-HEAD case
#      is flagged "(deleted in this diff)" so a reviewer can tell a dropped
#      frame apart from a plain stale one.
STALE=""
while IFS= read -r changed_baseline; do
  [[ -z "$changed_baseline" ]] && continue
  while IFS=$'\t' read -r device app slot_name row_baseline locale; do
    [[ "$row_baseline" == "$changed_baseline" ]] || continue
    if [[ "$locale" == "*" ]]; then
      locales_to_check=("${ALL_LOCALES[@]}")
    else
      locales_to_check=("$locale")
    fi
    for loc in "${locales_to_check[@]}"; do
      frame="${ASCSPEC_PREFIX}${app}/${device}/${loc}/${slot_name}.png"
      head_exists=0
      git cat-file -e "HEAD:${frame}" 2>/dev/null && head_exists=1
      base_exists=0
      git cat-file -e "${MERGE_BASE}:${frame}" 2>/dev/null && base_exists=1
      # Rule 1: never existed on either side (SKIPPED-NO-COPY locale) — skip.
      [[ "$head_exists" -eq 0 && "$base_exists" -eq 0 ]] && continue
      # Rule 2: present at HEAD and present (not deleted) in the diff — fresh.
      if [[ "$head_exists" -eq 1 ]] && grep -qxF "$frame" <<<"$CHANGED_PRESENT"; then
        continue
      fi
      # Rule 3: everything else is STALE — including a frame that existed at
      # MERGE_BASE but was deleted at HEAD (annotated below), which `grep`ing
      # CHANGED alone would have mistaken for "regenerated".
      frame_entry="$frame"
      if [[ "$head_exists" -eq 0 && "$base_exists" -eq 1 ]]; then
        frame_entry="${frame}  (deleted in this diff)"
      fi
      # Ordered device/app/slot/baseline/frame so a plain sort groups every
      # stale frame under its (device, app, slot, baseline) block below.
      STALE+="${device}"$'\t'"${app}"$'\t'"${slot_name}"$'\t'"${changed_baseline}"$'\t'"${frame_entry}"$'\n'
    done
  done <<<"$ROWS"
done <<<"$CHANGED_MAPPED"
STALE="$(printf '%s' "$STALE" | sort -u | sed '/^$/d')"

if [[ -z "$STALE" ]]; then
  echo "PASS [store_frame_drift]: every store frame fed by a changed baseline was regenerated in this diff."
  exit 0
fi

# One block per (device, app, slot, baseline): a header line naming the slot
# and the baseline that changed, then one "missing: <path>" line per stale
# frame — copy-paste-able, never comma-joined.
print_stale_blocks() {
  local prev_key="" device app slot_name baseline_relpath frame key
  while IFS=$'\t' read -r device app slot_name baseline_relpath frame; do
    [[ -z "$device" ]] && continue
    key="${device}"$'\t'"${app}"$'\t'"${slot_name}"$'\t'"${baseline_relpath}"
    if [[ "$key" != "$prev_key" ]]; then
      echo "  - ${device}/${app}/${slot_name}  (baseline changed: ${baseline_relpath})"
      prev_key="$key"
    fi
    echo "      missing: ${frame}"
  done <<<"$STALE"
}

# ── Escape hatch ──────────────────────────────────────────────────────────────
ESCAPE_REASON=""
if [[ "${FRAME_DRIFT_LABEL_OVERRIDE:-0}" == "1" ]]; then
  ESCAPE_REASON="PR label 'frame-drift-verified'"
elif TRAILER="$(git log --format=%B "${MERGE_BASE}..HEAD" | grep -iE '^Frame-Drift-Verified:' | head -1)"; then
  if [[ -n "$TRAILER" ]]; then
    ESCAPE_REASON="commit trailer: ${TRAILER}"
  fi
fi

if [[ -n "$ESCAPE_REASON" ]]; then
  echo "WARN [store_frame_drift]: mapped baseline(s) changed without regenerating every frame they feed, but the escape hatch was used ($ESCAPE_REASON) — passing."
  echo
  echo "Stale slot(s) the escape hatch is covering for — review these before approving:"
  print_stale_blocks
  exit 0
fi

{
  echo "FAIL [store_frame_drift]: mapped snapshot baseline(s) changed without regenerating every store frame they feed (the #995/#998/#1112 failure mode)."
  echo
  echo "Stale frame(s) — not updated in this diff:"
  print_stale_blocks
  echo
  echo "Fix — one of the following:"
  echo "  (a) Regenerate: on macOS (the generator needs system fonts not present"
  echo "      on this runner), run"
  echo "          python3 scripts/build-ascspec-screenshots.py"
  echo "      then commit every \"missing:\" frame listed above under"
  echo "      docs/app-store/screenshots-ascspec/."
  echo "  (b) Escape hatch — only if regenerating produces a byte-identical frame"
  echo "      (the compositor can absorb a small baseline change, e.g. an"
  echo "      unrelated test refactor, with no visible pixel difference, so"
  echo "      there is nothing to commit): add the PR label 'frame-drift-verified',"
  echo "      or add a commit-message trailer:"
  echo "          Frame-Drift-Verified: <why the frame doesn't need regenerating>"
} >&2
exit 1
